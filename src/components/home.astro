---
const linkedin = "https://linkedin.com/in/georgiyan-joby-b36b20281";
---

<section id="home" class="hero page-shell">
  <div class="hero-copy">
    <p class="hero-kicker">
      <span class="availability-dot"></span> BCA student · Kochi, India
    </p>
    <h1>
      Bridging Technology, People <span>&amp; Projects</span> to Build Meaningful
      Solutions.
    </h1>
    <p class="hero-intro">
      I'm Georgiyan, a technology enthusiast and BCA student interested in the
      intersection of technology, project management and business operations. I
      enjoy exploring emerging technologies, coordinating teams and turning
      ideas into structured solutions.
    </p>
    <p class="hero-designation">
      Technology Enthusiast <span>|</span> Project Coordination <span>|</span> Business
      Operations
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href="#projects"
        >Explore my work <span aria-hidden="true">↗</span></a
      >
      <a
        class="button button-secondary"
        href="/georgiyan-joby-resume.pdf"
        download="Georgiyan-Joby-Resume.pdf"
        >Download resume <span aria-hidden="true">↓</span></a
      >
    </div>
    <div class="hero-links">
      <a href="#contact">Let's connect</a>
      <a href={linkedin} target="_blank" rel="noopener noreferrer"
        >LinkedIn <span aria-hidden="true">↗</span></a
      >
      <a href="mailto:georgiyanjoby75@gmail.com"
        >Email <span aria-hidden="true">↗</span></a
      >
    </div>
  </div>

  <div
    class="hero-art"
    aria-label="Technology, collaboration and thoughtful execution"
  >
    <div class="art-orbit orbit-outer"></div>
    <div class="art-orbit orbit-inner"></div>
    <div class="art-core"><span>GJ</span><small>TECH × PEOPLE</small></div>
    <span class="orbit-label label-top">Curiosity</span>
    <span class="orbit-label label-right">Coordination</span>
    <span class="orbit-label label-bottom">Execution</span>
    <span class="orbit-label label-left">Ideas</span>
    <span class="art-star star-one">✳</span>
    <span class="art-star star-two">✦</span>
  </div>

  <div class="hero-footnote">
    <span>THIRD-YEAR BCA STUDENT</span>
    <span>MG UNIVERSITY · CLASS OF 2027</span>
    <a href="#about">Scroll to explore <span aria-hidden="true">↓</span></a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: min(790px, 100svh);
    grid-template-columns: minmax(0, 1.5fr) minmax(210px, 0.5fr);
    align-items: center;
    gap: clamp(28px, 5vw, 72px);
    padding-block: 124px 94px;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    animation: rise-in 750ms ease both;
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 25px;
    color: var(--muted);
    font-size: 13px;
    letter-spacing: 0.04em;
  }

  .availability-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #c7d7a2;
    box-shadow: 0 0 0 4px #c7d7a21a;
  }

  h1 {
    max-width: 750px;
    margin: 0;
    font-size: clamp(43px, 5vw, 68px);
    font-weight: 550;
    letter-spacing: -0.075em;
    line-height: 1.055;
  }

  h1 span {
    color: var(--accent);
  }

  .hero-intro {
    max-width: 640px;
    margin: 25px 0 0;
    color: var(--muted);
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.85;
  }

  .hero-designation {
    margin: 17px 0 0;
    color: var(--text);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.035em;
  }

  .hero-designation span {
    margin-inline: 5px;
    color: var(--accent);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 15px;
    padding: 0 19px;
    border: 1px solid transparent;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 650;
    text-decoration: none;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background 180ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: var(--accent);
    color: #17141e;
  }

  .button-primary:hover {
    background: #d3c3ff;
  }

  .button-secondary {
    border-color: var(--line);
    background: #ffffff05;
    color: var(--text);
  }

  .button-secondary:hover {
    border-color: #c6adff70;
    background: var(--accent-soft);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 27px;
  }

  .hero-links a {
    color: var(--muted);
    font-size: 12px;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .hero-links a:hover {
    color: var(--text);
  }

  .hero-links span {
    color: var(--accent);
  }

  .hero-art {
    position: relative;
    width: min(100%, 340px);
    aspect-ratio: 1;
    justify-self: center;
    animation: float-in 950ms 120ms ease both;
  }

  .art-orbit {
    position: absolute;
    inset: 10%;
    border: 1px solid #ffffff17;
    border-radius: 50%;
  }

  .orbit-outer {
    transform: rotate(-24deg) scaleX(0.75);
  }

  .orbit-inner {
    inset: 22%;
    border-color: #c6adff31;
    transform: rotate(38deg) scaleX(0.73);
  }

  .art-core {
    position: absolute;
    inset: 32%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 1px solid #c6adff42;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 40%, #c6adff18, #181916 72%);
    box-shadow: 0 0 80px #c6adff0d;
  }

  .art-core span {
    color: var(--text);
    font-size: 41px;
    font-weight: 500;
    letter-spacing: -0.08em;
  }

  .art-core small {
    margin-top: 4px;
    color: var(--muted);
    font-size: 7px;
    letter-spacing: 0.16em;
  }

  .orbit-label {
    position: absolute;
    padding: 7px 10px;
    border: 1px solid var(--line);
    border-radius: 50px;
    background: #151612;
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 0.02em;
  }

  .label-top {
    top: 4%;
    left: 36%;
  }

  .label-right {
    top: 46%;
    right: -9%;
  }

  .label-bottom {
    bottom: 3%;
    left: 38%;
  }

  .label-left {
    top: 49%;
    left: -8%;
  }

  .art-star {
    position: absolute;
    color: var(--accent);
  }

  .star-one {
    top: 18%;
    right: 19%;
    font-size: 18px;
  }

  .star-two {
    bottom: 19%;
    left: 18%;
    color: #c7d7a2;
    font-size: 15px;
  }

  .hero-footnote {
    position: absolute;
    right: 0;
    bottom: 26px;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    color: var(--subtle);
    font-size: 9px;
    font-weight: 650;
    letter-spacing: 0.14em;
  }

  .hero-footnote a {
    color: var(--muted);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0;
    text-decoration: none;
  }

  .hero-footnote a span {
    margin-left: 5px;
    color: var(--accent);
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes float-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 42px;
      padding-block: 130px 88px;
    }

    .hero-art {
      width: min(78vw, 300px);
    }
  }

  @media (max-width: 500px) {
    .hero {
      padding-top: 98px;
    }

    h1 {
      font-size: clamp(37px, 10vw, 40px);
      line-height: 1.02;
    }

    .hero-intro {
      margin-top: 18px;
      font-size: 14px;
    }

    .hero-designation {
      margin-top: 12px;
      font-size: 11px;
    }

    .hero-actions {
      gap: 8px;
      margin-top: 24px;
    }

    .button {
      min-height: 44px;
      gap: 8px;
      padding-inline: 12px;
      font-size: 11px;
    }

    .hero-footnote {
      bottom: 22px;
      font-size: 8px;
      letter-spacing: 0.08em;
    }

    .hero-footnote > span:nth-child(2) {
      display: none;
    }
  }
</style>
