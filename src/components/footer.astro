---
const currentYear = new Date().getFullYear();
---

<footer class="page-shell">
  <div class="footer-main">
    <a class="footer-name" href="#home">Georgiyan Joby<span>.</span></a>
    <p>Technology, people &amp; projects.</p>
    <div class="footer-links">
      <a href="mailto:georgiyanjoby75@gmail.com">Email</a>
      <a
        href="https://linkedin.com/in/georgiyan-joby-b36b20281"
        target="_blank"
        rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a
      >
      <a href="#home">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
  <div class="footer-legal">
    <span>© {currentYear} Georgiyan Joby. All rights reserved.</span>
    <span
      >Template design by <a
        href="https://github.com/Gothsec"
        target="_blank"
        rel="noopener noreferrer">Andres Hernandez</a
      > · Distributed by <a
        href="https://themewagon.com"
        target="_blank"
        rel="noopener noreferrer">ThemeWagon</a
      ></span
    >
  </div>
</footer>

<style>
  footer {
    padding-bottom: 30px;
  }

  .footer-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    padding-block: 27px;
  }

  .footer-name {
    color: var(--text);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.035em;
    text-decoration: none;
  }

  .footer-name span {
    color: var(--accent);
  }

  .footer-main p {
    margin: 0;
    color: var(--subtle);
    font-size: 10px;
  }

  .footer-links {
    display: flex;
    gap: 20px;
  }

  .footer-links a,
  .footer-legal {
    color: var(--subtle);
    font-size: 9px;
    text-decoration: none;
  }

  .footer-links a:hover,
  .footer-legal a:hover {
    color: var(--text);
  }

  .footer-links span {
    color: var(--accent);
  }

  .footer-legal {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding-top: 17px;
    border-top: 1px solid var(--line);
  }

  .footer-legal a {
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .footer-main {
      flex-wrap: wrap;
    }

    .footer-main p {
      order: 1;
      width: 100%;
    }

    .footer-legal {
      flex-direction: column;
      gap: 7px;
    }
  }
</style>
